DATABASE_URL="postgresql://user:password@localhost:5432/decorgrass"

# Dominio real de producción (sin barra final). Se usa en metadataBase,
# robots.txt y sitemap.xml — cambiar acá evita editar 3 archivos si el
# dominio final no es decorgrass.com.
SITE_URL="https://decorgrass.com"

# Sesión de admin del dashboard (/dashboard) — sin estas variables, cae a una
# credencial de desarrollo (ver app/lib/auth.ts). Definirlas en producción.
AUTH_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"
ADMIN_EMAIL="admin@decorgrass.com"
# Hash bcrypt de la contraseña real, no la contraseña en texto plano.
# Generar con: node -e "console.log(require('bcryptjs').hashSync('tu-password', 10))"
ADMIN_PASSWORD_HASH="$2b$10$..."

# Notificación por email al equipo comercial cuando entra un lead nuevo
# (opcional — sin estas dos variables, el lead se guarda igual, solo no se
# envía el aviso). Cuenta gratuita en https://resend.com
RESEND_API_KEY="re_..."
NOTIFICATION_EMAIL="ventas@decorgrass.com"

# Pagos con Wompi (carrito/checkout). Las tres vienen del dashboard de Wompi
# → Configuración → Secretos para integración técnica. NEXT_PUBLIC_* se
# expone al navegador (es la llave pública, está pensada para eso); las
# otras dos NUNCA deben salir del servidor.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_INTEGRITY_SECRET="test_integrity_..."
WOMPI_EVENTS_SECRET="test_events_..."
