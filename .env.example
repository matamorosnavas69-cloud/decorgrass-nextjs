DATABASE_URL="postgresql://user:password@localhost:5432/decorgrass"

# Sesión de admin del dashboard (/dashboard) — sin estas variables, cae a una
# credencial de desarrollo (ver app/lib/auth.ts). Definirlas en producción.
AUTH_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"
ADMIN_EMAIL="admin@decorgrass.com"
# Hash bcrypt de la contraseña real, no la contraseña en texto plano.
# Generar con: node -e "console.log(require('bcryptjs').hashSync('tu-password', 10))"
ADMIN_PASSWORD_HASH="$2b$10$..."
